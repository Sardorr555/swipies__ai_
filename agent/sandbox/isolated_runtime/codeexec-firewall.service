[Unit]
Description=Block CodeExec sandboxes from host services
Before=docker.service
After=network-pre.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c '/usr/sbin/iptables -C INPUT -s 10.240.0.0/16 -j DROP 2>/dev/null || /usr/sbin/iptables -I INPUT 1 -s 10.240.0.0/16 -j DROP'

[Install]
WantedBy=multi-user.target
