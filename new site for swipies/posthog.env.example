# Copy these entries into the PRIVATE landing service .env, never into web assets.
# Disabled until an explicitly authorized production release.
POSTHOG_ENABLED=0
POSTHOG_ENVIRONMENT=production
POSTHOG_PROJECT_ID=718705
POSTHOG_PROJECT_TOKEN=
POSTHOG_READ_API_KEY=
POSTHOG_API_HOST=https://us.posthog.com
POSTHOG_INGEST_HOST=https://us.i.posthog.com
POSTHOG_ASSET_HOST=https://us-assets.i.posthog.com
POSTHOG_CACHE_SECONDS=60
# Comma-separated internal CIDRs / anonymous visitor IDs; no data is sent for them.
POSTHOG_INTERNAL_CIDRS=
POSTHOG_INTERNAL_VISITOR_IDS=
# Optional; default is posthog-state.sqlite beside the PRIVATE landing database.
POSTHOG_STATE_DB=
